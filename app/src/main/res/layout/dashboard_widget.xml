<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/dashboard_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="4dp">

        <!-- Battery Block -->
    <FrameLayout
        android:id="@+id/block_battery"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="2dp">

        <LinearLayout
            android:id="@+id/battery_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/block_rounded"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/battery_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="--°C"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Steps Block -->
    <FrameLayout
        android:id="@+id/block_steps"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp">

        <LinearLayout
            android:id="@+id/steps_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/block_rounded"
            android:backgroundTint="#2196F3"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp">

            <!-- Шаги (верхняя строка) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👟"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/steps_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:text="—"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeMaxTextSize="14sp" />
            </LinearLayout>

            <!-- Расстояние (нижняя строка) -->
            <TextView
                android:id="@+id/distance_text"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="0 м"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="14sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- DNS Block -->
    <FrameLayout
        android:id="@+id/block_dns"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="2dp">

        <LinearLayout
            android:id="@+id/dns_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/block_rounded"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/dns_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/widget_icon" />

            <TextView
                android:id="@+id/dns_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="OFF"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    </LinearLayout>

    <!-- Sync Indicator (top-left corner) -->
    <ImageView
        android:id="@+id/sync_indicator"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|start"
        android:padding="4dp"
        android:src="@drawable/ic_sync_indicator"
        android:scaleType="fitCenter" />

</FrameLayout>
